{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "60000"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/credentials)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.local.backup)",
      "Read(**/.env.local.prod)",
      "Read(**/.env.prod)",
      "Read(**/.env.preprod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.qa)",
      "Read(**/.env.stage)",
      "Read(**/.env.live)",
      "Read(**/.env.ci)",
      "Read(**/.envrc)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Bash(git stash*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git -c *)",
      "Bash(git --config-env*)",
      "Bash(git * --config-env*)",
      "Bash(git --exec-path=*)",
      "Bash(git * --exec-path=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/kill-guard.py", "timeout": 5, "onFailure": "block" },
          { "type": "command", "command": "python3 ~/.claude/hooks/policy-guard.py", "timeout": 5, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/sonnet-workers-guard.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/write-guard.py", "timeout": 5, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/shed-load.py", "timeout": 3 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/vscode-guard.sh",
            "timeout": 15,
            "statusMessage": "Checking cloned repo for .vscode autorun risk..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/trim-output.py", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/trim-output.py", "timeout": 5 }
        ]
      }
    ]
  }
}
